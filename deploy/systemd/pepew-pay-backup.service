[Unit]
Description=PEPEW Payment Platform SQLite backup maintenance (VM-B)
After=local-fs.target
ConditionPathExists=/home/ubuntu/pepepow-electrumx-service/backend/.env

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/pepepow-electrumx-service
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/ubuntu/pepepow-electrumx-service/backend/scripts/payment_db_backup_maintenance.py --backup-dir /var/lib/pepew-pay/backups --keep 14 --min-free-mib 512

UMask=0077
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# SQLite WAL readers may need to update/create the shared-memory (-shm)
# sidecar even when the database itself is opened mode=ro. Keep the state
# directory writable inside this unit's private mount namespace so SQLite can
# coordinate safely, then pin the authoritative database and WAL/journal files
# read-only. The backup directory remains the only intended persistent output.
ReadWritePaths=/var/lib/pepew-pay
ReadOnlyPaths=/var/lib/pepew-pay/payments.sqlite3
ReadOnlyPaths=-/var/lib/pepew-pay/payments.sqlite3-wal
ReadOnlyPaths=-/var/lib/pepew-pay/payments.sqlite3-journal

[Install]
WantedBy=multi-user.target
