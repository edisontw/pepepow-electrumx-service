# VM-B staging/bootstrap environment for pay.pepepow.net.
# Keep all authoritative Payment Platform writers disabled until SQLite cutover.
APP_NAME=pepew-pay
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8088
APP_PUBLIC_BASE_URL=https://pay.pepepow.net

# VM-B reaches VM-A ElectrumX through the localhost SSH tunnel.
ELECTRUMX_HOST=127.0.0.1
ELECTRUMX_PORT=50001
ELECTRUMX_USE_SSL=false
ELECTRUMX_TIMEOUT=5.0

PEPEW_DECIMALS=8
PEPEW_ADDRESS_PREFIX=P
PEPEW_MIN_CONFIRMATIONS=3
PEPEW_EXPLORER_BASE_URL=https://explorer.pepepow.net

# Bootstrap mode: do not become a second authoritative writer.
PAYMENT_API_ENABLED=false
PAYMENT_DB_PATH=/var/lib/pepew-pay/staging.sqlite3
PAYMENT_DEFAULT_EXPIRY_SECONDS=900
PAYMENT_MAX_EXPIRY_SECONDS=86400
PAYMENT_CREATE_API_KEY=
PAYMENT_WATCHER_ENABLED=false
PAYMENT_WATCHER_SUBSCRIPTION_REFRESH_SECONDS=5
PAYMENT_WATCHER_RECONNECT_MIN_SECONDS=1
PAYMENT_WATCHER_RECONNECT_MAX_SECONDS=30
PAYMENT_WATCHER_MAX_SUBSCRIPTIONS=2000
PAYMENT_WATCHER_STALE_SECONDS=60

PAYMENT_WEBHOOK_ENABLED=false
PAYMENT_WEBHOOK_MASTER_KEY=
PAYMENT_WEBHOOK_TIMEOUT_SECONDS=5
PAYMENT_WEBHOOK_POLL_SECONDS=2
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8
PAYMENT_WEBHOOK_RETRY_BASE_SECONDS=30
PAYMENT_WEBHOOK_RETRY_MAX_SECONDS=3600
PAYMENT_WEBHOOK_BATCH_SIZE=20

CACHE_STATUS_SECONDS=10
CACHE_BALANCE_SECONDS=15
CACHE_HISTORY_SECONDS=30
CACHE_PAYMENT_SECONDS=5
CACHE_TX_SECONDS=300
CACHE_PRICE_SECONDS=120
CACHE_PRICE_STALE_SECONDS=900
PRICE_FETCH_TIMEOUT_SECONDS=5.0
LOG_LEVEL=INFO
